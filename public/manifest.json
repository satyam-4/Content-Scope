{
  "manifest_version": 3,
  "name": "ContentScope",
  "version": "1.0.0",
  "description": "Track your content consumption patterns.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "assets/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["assets/content.js"]
    }
  ],
  "permissions": ["storage", "tabs", "activeTab"]
}
